APP_DEBUG = true

; ------------------------------------------------------------
; 安全密钥（必改）：用于 Token 签名，请改为随机长字符串
; 生成示例：php -r "echo bin2hex(random_bytes(24));"
; ------------------------------------------------------------
APP_KEY = please-change-me-to-a-random-string-32bytes

; ------------------------------------------------------------
; 数据库驱动：mysql（生产）| sqlite（本地快速体验，沙箱验证用）
; ------------------------------------------------------------
DB_DRIVER = mysql

; SQLite（DB_DRIVER=sqlite 时生效，相对路径基于项目根目录）
SQLITE_DATABASE = database/app_release.sqlite

; MySQL（DB_DRIVER=mysql 时生效）
DB_HOST = 127.0.0.1
DB_NAME = app_release
DB_USER = root
DB_PASS = your-password
DB_PORT = 3306
DB_CHARSET = utf8mb4

; ------------------------------------------------------------
; 下载分发模式：
;   redirect - 302 重定向到 /storage/...（推荐，Nginx 需配置 alias）
;   xaccel   - X-Accel-Redirect 内部转发（Nginx 需配置 internal alias）
;   stream   - PHP 流式输出（开发环境使用，不支持大文件）
; ------------------------------------------------------------
DOWNLOAD_MODE = redirect

; 默认语言
DEFAULT_LANG = zh-cn
; ------------------------------------------------------------
; UCenter 2.0 账号同步（默认关闭；开启后本站与 UCenter 同账号登录）
;   UC_ENABLED      是否启用同步（true/false）
;   UC_API          UCenter 服务地址，如 https://uc.example.com
;   UC_KEY          通信密钥（UCenter 后台为本站应用分配，两端必须一致）
;   UC_APPID        本站应用 ID（UCenter 后台分配）
;   UC_IP           UCenter 服务器 IP（留空 = 不做来源 IP 校验）
;   UC_TIMEOUT      请求超时秒数
;   UC_SSL_VERIFY   是否校验 UC 通信 TLS 证书（true=校验，生产必须；自签名内网可 false）
;   UC_FALLBACK_LOGIN  UCenter 不可达时登录策略：uc(拒绝) | local(本地密码兜底)
;   UC_FALLBACK_WRITE  UCenter 不可达时注册/改密策略：strict(拒绝) | local(本地继续并标记待同步)
; ------------------------------------------------------------
UC_ENABLED = false
UC_API =
UC_KEY =
UC_APPID = 0
UC_IP =
UC_TIMEOUT = 5
UC_SSL_VERIFY = true
UC_FALLBACK_LOGIN = local
UC_FALLBACK_WRITE = local
